{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5.1"
    },
    "build": {
      "model": "opencode-go/glm-5.1"
    },
    "orchestrator": {
      "model": "opencode-go/glm-5.1"
    },
    "coder": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "analyst": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "reviewer": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "documenter": {
      "model": "opencode-go/deepseek-v4-pro"
    }
  },
  "mcp": {
    "mcp-github": {
      "enabled": false
    },
    "mcp-context7": {
      "enabled": true,
    },
    "mcp-ghgrep": {
      "enabled": true,
    },
    "mcp-todoist": {
      "enabled": false,
    },
    "mcp-websearch": {
      "enabled": true,
